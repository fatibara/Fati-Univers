// =============================================================================
// FATI UNIVERS — Modèle de données multi-écoles (MVP)
// =============================================================================
//
// RÈGLES D'OR (voir docs/MODELE_DE_DONNEES.md)
//
// 1. Toute table métier porte `tenantId` (l'établissement propriétaire).
// 2. PostgreSQL Row-Level Security (prisma/sql/001_rls.sql) refuse toute
//    ligne dont `tenantId` n'est pas l'établissement actif de la session,
//    même si le code oublie un filtre.
// 3. Les relations obligatoires entre tables métier utilisent une clé
//    étrangère COMPOSITE (tenantId, xxxId) -> (tenantId, id) : la base
//    interdit physiquement qu'une note de l'école A pointe vers un élève de
//    l'école B.
// 4. Les montants sont des ENTIERS en francs guinéens (GNF). Jamais de Float.
// 5. Les identifiants sont des UUID : le téléphone peut les créer hors-ligne.
// 6. Notes et paiements ne s'effacent pas : annulation tracée + AuditLog.
//
// Tables GLOBALES (sans tenantId) : User, UserSession, OtpCode, Plan.
// Tables PLATEFORME avec tenantId : Tenant (c'est l'établissement lui-même),
// Subscription, SupportAccessGrant, AuditLog.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ÉNUMÉRATIONS
// -----------------------------------------------------------------------------

enum TenantStatus {
  EN_ATTENTE
  ACTIF
  SUSPENDU
  ARCHIVE
}

enum Role {
  PROMOTEUR
  DIRECTEUR
  CENSEUR
  SECRETAIRE
  COMPTABLE
  CAISSIER
  ENSEIGNANT
  SURVEILLANT
  PARENT
  ELEVE
  BIBLIOTHECAIRE
  RESPONSABLE_TRANSPORT
  RESPONSABLE_CANTINE
  RESPONSABLE_INTERNAT
}

enum Cycle {
  MATERNELLE
  PRIMAIRE
  COLLEGE
  LYCEE
  SUPERIEUR
  FORMATION_PRO
}

enum Gender {
  M
  F
}

enum PeriodType {
  TRIMESTRE
  SEMESTRE
}

enum EnrollmentStatus {
  PREINSCRIT
  INSCRIT
  TRANSFERE
  ABANDON
  EXCLU
  DIPLOME
}

enum AssessmentType {
  INTERROGATION
  DEVOIR
  COMPOSITION
  EXAMEN
}

enum GradeStatus {
  NOTE
  ABSENT_JUSTIFIE
  ABSENT_NON_JUSTIFIE
  DISPENSE
}

enum AbsentPolicy {
  NON_COMPTE
  ZERO
}

enum ReportDecision {
  ADMIS
  REDOUBLE
  EXCLU
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  RETARD
}

enum FeeCategory {
  INSCRIPTION
  REINSCRIPTION
  SCOLARITE
  MENSUALITE
  TENUE
  FOURNITURES
  CANTINE
  TRANSPORT
  EXAMEN
  AUTRE
}

enum InvoiceStatus {
  EMISE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum PaymentMethod {
  ESPECES
  ORANGE_MONEY
  MTN_MOMO
  CARTE
  VIREMENT
}

enum PaymentStatus {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  ANNULE
}

enum CashSessionStatus {
  OUVERTE
  CLOTUREE
}

enum SmsStatus {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum ImportStatus {
  ANALYSE
  PRET
  IMPORTE
  ANNULE
  ERREUR
}

enum SubscriptionStatus {
  ESSAI
  ACTIF
  IMPAYE
  LECTURE_SEULE
  RESILIE
}

enum BillingCycle {
  MENSUEL
  ANNUEL
}

// -----------------------------------------------------------------------------
// COMPTES ET IDENTITÉ (GLOBAL)
// -----------------------------------------------------------------------------

/// Un compte = une personne, identifiée par son téléphone. Une même personne
/// peut être directeur dans une école et parent dans une autre : ce sont des
/// Membership différentes, pas des comptes différents.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  phone              String    @unique /// format E.164, ex. +224620000000
  email              String?   @unique
  firstName          String
  lastName           String
  passwordHash       String? /// scrypt ; null = connexion par code SMS uniquement
  isSuperAdmin       Boolean   @default(false)
  twoFactorSecret    String? /// chiffré applicativement
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  preferredLanguage  String    @default("fr")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships        Membership[]
  sessions           UserSession[]
  guardianProfiles   Guardian[]
  staffProfiles      StaffMember[]
  supportGrants      SupportAccessGrant[] @relation("SupportGrantee")
  supportApprovals   SupportAccessGrant[] @relation("SupportApprover")
}

/// Jeton de renouvellement (refresh token) haché, révocable.
model UserSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Code à usage unique envoyé par SMS (connexion, réinitialisation).
model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  phone       String
  codeHash    String
  purpose     String /// "LOGIN" | "RESET_PASSWORD" | "VERIFY_PHONE"
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, purpose])
}

// -----------------------------------------------------------------------------
// PLATEFORME : ÉTABLISSEMENTS, ABONNEMENTS, ASSISTANCE
// -----------------------------------------------------------------------------

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique /// ex. "gs-les-elites-kaloum"
  name            String
  shortName       String /// nom court pour l'expéditeur SMS (11 caractères max)
  status          TenantStatus @default(EN_ATTENTE)
  country         String       @default("GN")
  currency        String       @default("GNF")
  timezone        String       @default("Africa/Conakry")
  city            String?
  address         String?
  phone           String?
  email           String?
  logoKey         String? /// clé du fichier dans le stockage S3
  cycles          Cycle[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
  subscriptions   Subscription[]
  supportGrants   SupportAccessGrant[]
  campuses        Campus[]
  academicYears   AcademicYear[]
  terms           Term[]
  levels          Level[]
  tracks          Track[]
  classrooms      Classroom[]
  rooms           Room[]
  subjects        Subject[]
  coefficients    SubjectCoefficient[]
  gradingPolicies GradingPolicy[]
  staff           StaffMember[]
  assignments     TeachingAssignment[]
  students        Student[]
  guardians       Guardian[]
  studentGuardians StudentGuardian[]
  enrollments     Enrollment[]
  assessments     Assessment[]
  grades          Grade[]
  reportCards     ReportCard[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  timetableEntries   TimetableEntry[]
  feeTypes        FeeType[]
  feeRates        FeeRate[]
  invoices        Invoice[]
  invoiceLines    InvoiceLine[]
  installments    Installment[]
  cashSessions    CashSession[]
  payments        Payment[]
  allocations     PaymentAllocation[]
  mobileMoneyTxs  MobileMoneyTransaction[]
  receiptCounter  ReceiptCounter?
  announcements   Announcement[]
  smsMessages     SmsMessage[]
  importJobs      ImportJob[]
  auditLogs       AuditLog[]
}

/// Formule commerciale (gérée par le super-admin).
model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique /// "ETABLISSEMENT" | "PROFESSIONNELLE" | "PREMIUM"
  name             String
  maxStudents      Int? /// null = illimité
  monthlyPriceGnf  Int
  yearlyPriceGnf   Int
  monthlySmsCredit Int
  features         String[] /// modules inclus, ex. ["DISCIPLINE", "LMD"]
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions    Subscription[]
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  planId        String             @db.Uuid
  status        SubscriptionStatus @default(ESSAI)
  billingCycle  BillingCycle       @default(ANNUEL)
  startsAt      DateTime
  endsAt        DateTime
  smsUsedThisMonth Int             @default(0)
  extraSmsCredit   Int             @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  plan          Plan               @relation(fields: [planId], references: [id])

  @@index([tenantId])
}

/// Accès temporaire du support FATI aux données d'une école : uniquement sur
/// demande, approuvé, limité dans le temps et journalisé.
model SupportAccessGrant {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  granteeId     String    @db.Uuid /// super-admin qui accède
  approvedById  String?   @db.Uuid /// directeur de l'école qui a accepté
  reason        String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  grantee       User      @relation("SupportGrantee", fields: [granteeId], references: [id])
  approvedBy    User?     @relation("SupportApprover", fields: [approvedById], references: [id])

  @@index([tenantId])
}

/// Rôles d'un compte dans un établissement. RLS spéciale : une ligne est
/// visible si elle appartient à l'école active OU au compte connecté (pour
/// lister « mes écoles » à la connexion).
model Membership {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  roles       Role[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// STRUCTURE PÉDAGOGIQUE
// -----------------------------------------------------------------------------

model Campus {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  address    String?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  classrooms Classroom[]
  rooms      Room[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model AcademicYear {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  label      String /// ex. "2027-2028"
  startsOn   DateTime  @db.Date
  endsOn     DateTime  @db.Date
  periodType PeriodType @default(TRIMESTRE)
  isCurrent  Boolean   @default(false)
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  terms       Term[]
  classrooms  Classroom[]
  enrollments Enrollment[]
  feeRates    FeeRate[]
  invoices    Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, label])
}

/// Trimestre ou semestre.
model Term {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  academicYearId String    @db.Uuid
  name           String /// "1er trimestre"
  position       Int /// 1, 2, 3
  startsOn       DateTime  @db.Date
  endsOn         DateTime  @db.Date
  gradesLockedAt DateTime? /// après validation des bulletins

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  academicYear   AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id])
  assessments    Assessment[]
  reportCards    ReportCard[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, position])
}

/// Niveau : CP1, 7e année, Terminale, Licence 1...
model Level {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  cycle       Cycle
  name        String
  position    Int /// ordre d'affichage et de passage en classe supérieure
  gradeScale  Int     @default(20) /// note maximale : 10 au primaire, 20 au secondaire (configurable)

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  classrooms   Classroom[]
  coefficients SubjectCoefficient[]
  policies     GradingPolicy[]
  feeRates     FeeRate[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

/// Filière ou profil : Sciences sociales (SS), Sciences expérimentales (SE),
/// Sciences mathématiques (SM), ou filière universitaire / professionnelle.
model Track {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  code       String /// "SS", "SE", "SM"
  name       String

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  classrooms   Classroom[]
  coefficients SubjectCoefficient[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

/// Classe d'une année donnée : « 10e année A — 2027-2028 ».
model Classroom {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @db.Uuid
  academicYearId   String  @db.Uuid
  levelId          String  @db.Uuid
  trackId          String? @db.Uuid
  campusId         String? @db.Uuid
  name             String /// "10e A"
  capacity         Int?
  mainTeacherId    String? @db.Uuid /// professeur principal

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  academicYear     AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id])
  level            Level        @relation(fields: [tenantId, levelId], references: [tenantId, id])
  track            Track?       @relation(fields: [trackId], references: [id])
  campus           Campus?      @relation(fields: [campusId], references: [id])
  mainTeacher      StaffMember? @relation("MainTeacher", fields: [mainTeacherId], references: [id])
  enrollments      Enrollment[]
  assignments      TeachingAssignment[]
  assessments      Assessment[]
  attendanceSessions AttendanceSession[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, academicYearId, name])
}

model Room {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  campusId  String? @db.Uuid
  name      String
  capacity  Int?

  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  campus           Campus? @relation(fields: [campusId], references: [id])
  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Subject {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  code      String /// "MATH", "FR", "PHY"
  name      String

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  coefficients SubjectCoefficient[]
  assignments  TeachingAssignment[]
  assessments  Assessment[]
  timetableEntries TimetableEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

/// Coefficient d'une matière pour un niveau (et éventuellement un profil).
model SubjectCoefficient {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  levelId     String  @db.Uuid
  subjectId   String  @db.Uuid
  trackId     String? @db.Uuid
  coefficient Int     @default(1)

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  level       Level   @relation(fields: [tenantId, levelId], references: [tenantId, id])
  subject     Subject @relation(fields: [tenantId, subjectId], references: [tenantId, id])
  track       Track?  @relation(fields: [trackId], references: [id])

  @@unique([tenantId, levelId, subjectId, trackId])
}

/// Règles de calcul des moyennes, par niveau (null = règle par défaut de l'école).
model GradingPolicy {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  levelId          String?      @db.Uuid
  absentPolicy     AbsentPolicy @default(NON_COMPTE)
  decimals         Int          @default(2)
  /// Poids par type d'évaluation, ex. {"DEVOIR":1,"COMPOSITION":2}
  typeWeights      Json         @default("{\"INTERROGATION\":1,\"DEVOIR\":1,\"COMPOSITION\":2,\"EXAMEN\":2}")
  /// Mentions par tranche de moyenne (sur 20), ex. [{"min":16,"label":"Très bien"}]
  mentions         Json         @default("[]")
  /// Moyenne annuelle : "MOYENNE_DES_PERIODES" ou poids par période, ex. [1,1,2]
  annualRule       Json         @default("\"MOYENNE_DES_PERIODES\"")
  passingAverage   Decimal      @default(10) @db.Decimal(5, 2)

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  level            Level?       @relation(fields: [levelId], references: [id])

  @@unique([tenantId, levelId])
}

// -----------------------------------------------------------------------------
// PERSONNES DE L'ÉCOLE
// -----------------------------------------------------------------------------

/// Enseignant ou membre du personnel. `userId` relie à un compte s'il en a un.
model StaffMember {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String?  @db.Uuid
  firstName   String
  lastName    String
  phone       String?
  position    String? /// "Professeur de mathématiques", "Caissière"
  hiredOn     DateTime? @db.Date
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant           Tenant  @relation(fields: [tenantId], references: [id])
  user             User?   @relation(fields: [userId], references: [id])
  mainClassrooms   Classroom[] @relation("MainTeacher")
  assignments      TeachingAssignment[]
  timetableEntries TimetableEntry[]
  assessments      Assessment[]
  attendanceTaken  AttendanceSession[]
  cashSessions     CashSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
}

/// Qui enseigne quelle matière dans quelle classe.
model TeachingAssignment {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  classroomId String  @db.Uuid
  subjectId   String  @db.Uuid
  staffId     String  @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  classroom   Classroom   @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  subject     Subject     @relation(fields: [tenantId, subjectId], references: [tenantId, id])
  staff       StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id])

  @@unique([tenantId, classroomId, subjectId])
  @@index([tenantId, staffId])
}

model Student {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  matricule     String /// unique dans l'école, ex. "2027-0042"
  firstName     String
  lastName      String
  gender        Gender
  birthDate     DateTime? @db.Date
  birthPlace    String?
  nationality   String   @default("GN")
  photoKey      String?
  medicalNotes  String? /// accès restreint (directeur, surveillant)
  userId        String?  @db.Uuid /// compte élève (lycée, université)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  guardians     StudentGuardian[]
  enrollments   Enrollment[]
  grades        Grade[]
  reportCards   ReportCard[]
  attendance    AttendanceRecord[]
  invoices      Invoice[]
  payments      Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, matricule])
  @@index([tenantId, lastName, firstName])
}

/// Parent ou tuteur, tel que connu de l'école. `userId` relie à son compte
/// global : c'est ce qui permet un seul compte pour des enfants dans
/// plusieurs écoles.
model Guardian {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String?  @db.Uuid
  firstName   String
  lastName    String
  phone       String /// E.164 ; reçoit les SMS
  phone2      String?
  profession  String?
  address     String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  students    StudentGuardian[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
}

model StudentGuardian {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String /// "PERE", "MERE", "TUTEUR"...
  isPrimary    Boolean  @default(false) /// payeur et premier contact
  receivesSms  Boolean  @default(true)

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  student      Student  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [tenantId, guardianId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, studentId, guardianId])
  @@index([tenantId, guardianId])
}

/// Inscription d'un élève dans une classe pour une année.
model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  classroomId    String           @db.Uuid
  academicYearId String           @db.Uuid
  status         EnrollmentStatus @default(PREINSCRIT)
  enrolledOn     DateTime         @default(now()) @db.Date
  leftOn         DateTime?        @db.Date
  isRepeating    Boolean          @default(false)
  notes          String?

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  student        Student      @relation(fields: [tenantId, studentId], references: [tenantId, id])
  classroom      Classroom    @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  academicYear   AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id])
  invoices       Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, academicYearId])
  @@index([tenantId, classroomId])
}

// -----------------------------------------------------------------------------
// NOTES ET BULLETINS
// -----------------------------------------------------------------------------

model Assessment {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  classroomId String         @db.Uuid
  subjectId   String         @db.Uuid
  termId      String         @db.Uuid
  createdById String         @db.Uuid /// StaffMember
  type        AssessmentType
  title       String
  date        DateTime       @db.Date
  maxScore    Decimal        @default(20) @db.Decimal(5, 2)
  weight      Decimal        @default(1) @db.Decimal(5, 2)
  createdAt   DateTime       @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  classroom   Classroom   @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  subject     Subject     @relation(fields: [tenantId, subjectId], references: [tenantId, id])
  term        Term        @relation(fields: [tenantId, termId], references: [tenantId, id])
  createdBy   StaffMember @relation(fields: [tenantId, createdById], references: [tenantId, id])
  grades      Grade[]

  @@unique([tenantId, id])
  @@index([tenantId, classroomId, termId])
}

model Grade {
  id           String      @id @default(uuid()) @db.Uuid /// créé sur le téléphone (hors-ligne)
  tenantId     String      @db.Uuid
  assessmentId String      @db.Uuid
  studentId    String      @db.Uuid
  status       GradeStatus @default(NOTE)
  score        Decimal?    @db.Decimal(5, 2) /// null si absent ou dispensé
  comment      String?
  updatedById  String?     @db.Uuid /// User
  clientUpdatedAt DateTime? /// horodatage de la saisie sur l'appareil
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  assessment   Assessment  @relation(fields: [tenantId, assessmentId], references: [tenantId, id])
  student      Student     @relation(fields: [tenantId, studentId], references: [tenantId, id])

  @@unique([tenantId, assessmentId, studentId])
}

model ReportCard {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  studentId     String          @db.Uuid
  termId        String          @db.Uuid
  average       Decimal?        @db.Decimal(5, 2)
  rank          Int?
  classSize     Int?
  mention       String?
  decision      ReportDecision?
  teacherRemark String?
  directorRemark String?
  validatedAt   DateTime?
  validatedById String?         @db.Uuid
  pdfKey        String?
  createdAt     DateTime        @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  student       Student         @relation(fields: [tenantId, studentId], references: [tenantId, id])
  term          Term            @relation(fields: [tenantId, termId], references: [tenantId, id])

  @@unique([tenantId, studentId, termId])
}

// -----------------------------------------------------------------------------
// PRÉSENCES ET EMPLOIS DU TEMPS
// -----------------------------------------------------------------------------

model AttendanceSession {
  id               String   @id @default(uuid()) @db.Uuid /// créé hors-ligne
  tenantId         String   @db.Uuid
  classroomId      String   @db.Uuid
  takenById        String   @db.Uuid /// StaffMember
  timetableEntryId String?  @db.Uuid
  date             DateTime @db.Date
  startTime        String? /// "08:00"
  createdAt        DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  classroom      Classroom       @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  takenBy        StaffMember     @relation(fields: [tenantId, takenById], references: [tenantId, id])
  timetableEntry TimetableEntry? @relation(fields: [timetableEntryId], references: [id])
  records        AttendanceRecord[]

  @@unique([tenantId, id])
  @@index([tenantId, classroomId, date])
}

model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  sessionId     String           @db.Uuid
  studentId     String           @db.Uuid
  status        AttendanceStatus @default(PRESENT)
  minutesLate   Int?
  justified     Boolean          @default(false)
  justification String?
  smsSentAt     DateTime?

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  session       AttendanceSession @relation(fields: [tenantId, sessionId], references: [tenantId, id])
  student       Student           @relation(fields: [tenantId, studentId], references: [tenantId, id])

  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId, studentId])
}

model TimetableEntry {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  classroomId String  @db.Uuid
  subjectId   String  @db.Uuid
  staffId     String? @db.Uuid
  roomId      String? @db.Uuid
  dayOfWeek   Int /// 1 = lundi ... 6 = samedi
  startTime   String /// "08:00"
  endTime     String /// "09:55"

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  classroom   Classroom    @relation(fields: [tenantId, classroomId], references: [tenantId, id])
  subject     Subject      @relation(fields: [tenantId, subjectId], references: [tenantId, id])
  staff       StaffMember? @relation(fields: [staffId], references: [id])
  room        Room?        @relation(fields: [roomId], references: [id])
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, id])
  @@index([tenantId, classroomId, dayOfWeek])
}

// -----------------------------------------------------------------------------
// FINANCES : FRAIS, FACTURES, ÉCHÉANCES, CAISSE, PAIEMENTS
// -----------------------------------------------------------------------------

model FeeType {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  category  FeeCategory
  name      String /// "Scolarité annuelle", "Tenue"
  isActive  Boolean     @default(true)

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  rates        FeeRate[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

/// Montant d'un frais pour un niveau et une année.
model FeeRate {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  feeTypeId      String @db.Uuid
  levelId        String @db.Uuid
  academicYearId String @db.Uuid
  amountGnf      Int
  installments   Int    @default(1) /// nombre d'échéances proposé

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  feeType        FeeType      @relation(fields: [tenantId, feeTypeId], references: [tenantId, id])
  level          Level        @relation(fields: [tenantId, levelId], references: [tenantId, id])
  academicYear   AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id])

  @@unique([tenantId, feeTypeId, levelId, academicYearId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  number         String /// "F-2027-000123"
  studentId      String        @db.Uuid
  enrollmentId   String?       @db.Uuid
  academicYearId String        @db.Uuid
  status         InvoiceStatus @default(EMISE)
  issuedOn       DateTime      @default(now()) @db.Date
  totalGnf       Int /// somme des lignes, remises déduites
  paidGnf        Int           @default(0) /// maintenu à jour par les allocations confirmées
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  student        Student       @relation(fields: [tenantId, studentId], references: [tenantId, id])
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id])
  academicYear   AcademicYear  @relation(fields: [tenantId, academicYearId], references: [tenantId, id])
  lines          InvoiceLine[]
  installments   Installment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, studentId])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  invoiceId   String  @db.Uuid
  feeTypeId   String  @db.Uuid
  label       String
  amountGnf   Int
  discountGnf Int     @default(0)
  discountReason String? /// obligatoire si remise (contrôlé par l'API)

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  invoice     Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  feeType     FeeType @relation(fields: [tenantId, feeTypeId], references: [tenantId, id])
}

/// Échéance : ce que le parent doit payer, et quand.
model Installment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  invoiceId  String   @db.Uuid
  position   Int
  dueOn      DateTime @db.Date
  amountGnf  Int
  paidGnf    Int      @default(0)
  lastReminderAt DateTime?

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  invoice     Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id])
  allocations PaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, position])
  @@index([tenantId, dueOn])
}

/// Session de caisse d'un caissier : ouverture le matin, clôture le soir.
model CashSession {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  cashierId          String            @db.Uuid /// StaffMember
  status             CashSessionStatus @default(OUVERTE)
  openedAt           DateTime          @default(now())
  openingFloatGnf    Int               @default(0)
  closedAt           DateTime?
  expectedGnf        Int? /// calculé à la clôture
  countedGnf         Int? /// compté par le caissier
  discrepancyNote    String? /// obligatoire si écart

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  cashier   StaffMember @relation(fields: [tenantId, cashierId], references: [tenantId, id])
  payments  Payment[]

  @@unique([tenantId, id])
  @@index([tenantId, cashierId, status])
}

/// Compteur de reçus, une ligne par école : numérotation continue sans trou.
model ReceiptCounter {
  tenantId   String @id @db.Uuid
  nextNumber Int    @default(1)

  tenant     Tenant @relation(fields: [tenantId], references: [id])
}

/// Un paiement ne se supprime jamais : il s'annule (status ANNULE + motif).
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  receiptNumber   Int? /// attribué à la confirmation, continu par école
  studentId       String        @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(EN_ATTENTE)
  amountGnf       Int
  payerName       String?
  payerPhone      String?
  cashSessionId   String?       @db.Uuid /// obligatoire pour ESPECES (contrôlé par l'API)
  receivedById    String?       @db.Uuid /// User
  idempotencyKey  String /// évite les doublons (double clic, renvoi hors-ligne)
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelledById   String?       @db.Uuid
  cancelApprovedById String?    @db.Uuid /// directeur
  cancelReason    String?
  createdAt       DateTime      @default(now())

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  student         Student       @relation(fields: [tenantId, studentId], references: [tenantId, id])
  cashSession     CashSession?  @relation(fields: [cashSessionId], references: [id])
  allocations     PaymentAllocation[]
  mobileMoneyTxs  MobileMoneyTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, studentId])
  @@index([tenantId, createdAt])
}

/// Répartition d'un paiement sur une ou plusieurs échéances.
model PaymentAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  paymentId     String      @db.Uuid
  installmentId String      @db.Uuid
  amountGnf     Int

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  payment       Payment     @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  installment   Installment @relation(fields: [tenantId, installmentId], references: [tenantId, id])

  @@unique([tenantId, paymentId, installmentId])
}

/// Transaction Orange Money / MTN MoMo. Le paiement n'est CONFIRME qu'après
/// confirmation de l'opérateur (notification serveur + vérification du statut).
model MobileMoneyTransaction {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  paymentId        String        @db.Uuid
  provider         PaymentMethod /// ORANGE_MONEY | MTN_MOMO
  providerTxId     String? /// référence de l'opérateur
  status           PaymentStatus @default(EN_ATTENTE)
  amountGnf        Int
  payerPhone       String
  lastCheckedAt    DateTime?
  rawCallback      Json?
  reconciledAt     DateTime?
  createdAt        DateTime      @default(now())

  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  payment          Payment       @relation(fields: [tenantId, paymentId], references: [tenantId, id])

  @@unique([provider, providerTxId])
  @@index([tenantId, status])
}

// -----------------------------------------------------------------------------
// COMMUNICATION
// -----------------------------------------------------------------------------

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  title       String
  body        String
  audience    String /// "TOUS" | "PARENTS" | "ENSEIGNANTS" | "CLASSE:<id>" | "NIVEAU:<id>"
  sendSms     Boolean   @default(false)
  publishedAt DateTime?
  createdById String    @db.Uuid /// User
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
}

model SmsMessage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  toPhone     String
  body        String /// 160 caractères max par segment
  segments    Int       @default(1)
  purpose     String /// "ABSENCE", "RECU", "RELANCE", "BULLETIN", "ANNONCE", "OTP"
  status      SmsStatus @default(EN_ATTENTE)
  provider    String?
  providerRef String?
  error       String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

// -----------------------------------------------------------------------------
// IMPORT ET JOURNAL D'AUDIT
// -----------------------------------------------------------------------------

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  kind        String /// "ELEVES", "PARENTS", "ENSEIGNANTS", "CLASSES", "FRAIS", "SOLDES"
  status      ImportStatus @default(ANALYSE)
  fileKey     String
  report      Json? /// erreurs ligne par ligne, compteurs
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
}

/// Journal non modifiable : UPDATE et DELETE sont interdits par la base
/// (prisma/sql/002_audit_append_only.sql).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid /// null = action plateforme
  actorUserId String?  @db.Uuid
  action      String /// "GRADE_UPDATED", "PAYMENT_CANCELLED", "ROLE_CHANGED"...
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}
